# =====================================================================
#  CONFIGURACIÓN  (en mundos hardcore no hay comandos: edita este
#  archivo ANTES de subir el mundo. 1 = activado, 0 = desactivado)
# =====================================================================
# Reinicio del mundo cuando alguien muere
scoreboard players set #enabled wr.state 1
# Segundos de cuenta regresiva antes del reinicio
scoreboard players set #seconds wr.state 5
# Inventario compartido entre todos los jugadores
scoreboard players set #share_inv wr.state 1
# Corazones compartidos
scoreboard players set #share_hp wr.state 1
# Hambre compartida
scoreboard players set #share_food wr.state 1
